# Base URL of the Ledger API (money-api), including the /api/v1 prefix.
# Copy this file to `.env` and adjust for where you run the app:
#   - iOS simulator / web on the same machine: http://localhost:8080/api/v1
#   - Android emulator: http://10.0.2.2:8080/api/v1 (10.0.2.2 is the host's loopback)
#   - Physical device: http://<your-machine-LAN-IP>:8080/api/v1 (e.g. http://192.168.1.20:8080/api/v1)
# EXPO_PUBLIC_* vars are inlined at build time; restart `expo start` after changing it.
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Privacy policy and terms pages (docs/ served by GitHub Pages). Leave unset
# to use the defaults in src/lib/legal.ts.
# EXPO_PUBLIC_PRIVACY_URL=https://bookghf.github.io/bavemoney-app/privacy.html
# EXPO_PUBLIC_TERMS_URL=https://bookghf.github.io/bavemoney-app/terms.html
